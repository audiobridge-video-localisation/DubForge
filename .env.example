DATABASE_URL=postgresql+asyncpg://dubforge:dubforge@localhost:5432/dubforge
REDIS_URL=redis://localhost:6379/0
LOG_LEVEL=INFO
STORAGE_DIR=./media
API_BASE_URL=http://localhost:8000
# Optional: real transcription + speaker diarization via AssemblyAI.
# Leave blank to use the built-in mock STT/diarization providers.
ASSEMBLYAI_API_KEY=
# STT provider selection: mock | whisper
STT_PROVIDER=mock
WHISPER_MODEL=small.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8