DATABASE_URL=postgresql+asyncpg://dubforge:dubforge@localhost:5432/dubforge
REDIS_URL=redis://localhost:6379/0
LOG_LEVEL=INFO
STORAGE_DIR=./media
API_BASE_URL=http://localhost:8000
# Optional: real transcription + speaker diarization via AssemblyAI.
# Leave blank to use the built-in mock STT/diarization providers.
ASSEMBLYAI_API_KEY=
# STT provider selection: mock | whisper
STT_PROVIDER=mock
WHISPER_MODEL=small.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Translation provider selection: mock | nllb
TRANSLATION_PROVIDER=mock
# TTS provider selection: mock | edge | mms
TTS_PROVIDER=mock
# Target language(s) for translation/TTS; comma-separated, only the first is used today
TARGET_LANGS=hi
# Segments shorter than this are merged into a neighbour before translation/TTS
MIN_SEGMENT_MS=500

# --- Docker (docker compose up --build) -------------------------------------------------
# Everything below is optional; the defaults work. Providers above (STT/TRANSLATION/TTS,
# WHISPER_*, TARGET_LANGS, MIN_SEGMENT_MS, ASSEMBLYAI_API_KEY) are passed to the worker.
# Where the app opens on your machine:
WEB_PORT=8080
# Direct API access for curl / interactive docs (localhost only): http://localhost:8001/docs
API_PORT=8001
POSTGRES_PASSWORD=dubforge
# Extra model packages to build into the worker image, space separated. Needed for real
# translation / voices; torch makes the image several GB. Examples: "nllb", "nllb tts-edge",
# "nllb tts-mms". Leave empty for the lightweight image (mock providers + Whisper).
PIPELINE_EXTRAS=
